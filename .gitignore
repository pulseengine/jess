
# Rivet external project cache
.rivet/
.rivet/repos/
.rivet/supplier-cache/
.scratch/
bazel-bin
bazel-out
bazel-jess
bazel-testlogs
MODULE.bazel.lock

# renode-test / robot framework outputs
robot_output.xml
log.html
report.html
snapshots/

# Renode robot per-run output (regenerated; the .robot file is the evidence)
logs/
# assembled silicon bring-up payloads (rebuild from sig.S via build.sh)
hardware/silicon/**/*.o
hardware/silicon/**/*.elf
hardware/silicon/**/*.bin
# jess wasm components: rebuilt by tools/appcompose/build-and-verify.sh
app/*/target/
app/*/*.wasm
.scratch/tprobe/
.scratch/einit/
.scratch/floop/
.scratch/invoke/

# Python bytecode caches. Two were tracked (tools/bench/, tools/cascade-differential/)
# and turned up when a source edit showed the .pyc as modified alongside it. A committed
# bytecode cache is a stale artifact that CPython will prefer over the source when the
# recorded mtime/size happen to match — exactly the staleness class AFD-047/049 and AFD-124
# cost this repo days over, in a file nobody looks at.
__pycache__/
*.pyc
