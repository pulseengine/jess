--  Pixhawk 6X-RT (Holybro, Standard v2A) — jess Phase-2 hardware platform.
--
--  Multi-processor flight-controller model. The FMU is an NXP i.MX RT1176
--  crossover MCU (Cortex-M7 @ up to 1 GHz + Cortex-M4 @ 400 MHz); a separate
--  STM32F100 (Cortex-M3) is the I/O coprocessor. jess binds the verified
--  falcon flight stack (wasm -> meld -> synth -> gale) to the M7, and the
--  PWM/failsafe path to the I/O MCU. Sensors hang off SPI/I2C; peripherals and
--  later smart actuators hang off CAN-FD (DroneCAN).
--
--  Sourced from PX4 fmu-v6xrt + Holybro 6X-RT + NXP RT1176 docs (see
--  artifacts/design-decisions.yaml DD-007 for citations and the porting plan).

package Pixhawk6XRT
public

  --------------------------------------------------------------------------
  -- Processors (3 cores across 2 packages)
  --------------------------------------------------------------------------
  --  i.MX RT1176 primary core. Target: cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard
  --  (double-precision FPU).
  --  FLIGHT RUNTIME = gale-MAXIMAL-WASM (DD-017), NOT full Zephyr: the verified gale
  --  kernel primitives (standalone plain/ track + wasm dist; incl. mpu/mem_domain =
  --  the native MPU enforcement, resolving AFD-028) are the thin native base; kiln +
  --  falcon + the relay-hal drivers are fused wasm (meld->loom->synth->ARM) and
  --  LOAD-TO-RAM into TCM (DD-016 - small image, no XIP, no i.MX boot ROM in flight).
  --  Zephyr is reference/validation only (gale's 36 QEMU suites + optional bring-up).
  processor FMU_M7
  end FMU_M7;
  processor implementation FMU_M7.imxrt1176
  end FMU_M7.imxrt1176;

  --  i.MX RT1176 secondary core (Cortex-M4, fpv4-sp). Idle under PX4 today;
  --  jess may offload here later (asymmetric multiprocessing). Modeled so the
  --  binding story is explicit from the start.
  processor FMU_M4
  end FMU_M4;
  processor implementation FMU_M4.imxrt1176
  end FMU_M4.imxrt1176;

  --  STM32F100 (Cortex-M3, 24 MHz, 8 KB SRAM) I/O coprocessor: PWM out +
  --  RC/SBUS failsafe, independent of the FMU. Runtime here is the gust gale-nano
  --  maximal-wasm subset (gale primitive subset + kiln, ~4-item native shim) - 8 KB
  --  SRAM is too small for Zephyr. Same gale-maximal-wasm model as the M7 (DD-017),
  --  just the gale-nano subset (DD-011) - so M7 and F100 are one architecture at two
  --  scales; neither runs full Zephyr in flight.
  processor IO_MCU
  end IO_MCU;
  processor implementation IO_MCU.stm32f100
  end IO_MCU.stm32f100;

  --------------------------------------------------------------------------
  -- Memory (i.MX RT1176 FlexRAM partition as PX4 maps it)
  --------------------------------------------------------------------------
  memory ITCM   end ITCM;     -- 256 KB @ 0x00000000 (M7 instruction TCM)
  memory DTCM   end DTCM;     -- 256 KB @ 0x20000000 (M7 data TCM)
  memory OCRAM  end OCRAM;    -- ~1.5 MB @ 0x20240000 (shared on-chip RAM)
  memory OSPI_FLASH end OSPI_FLASH; -- 64 MB octal SPI XIP (code)

  --------------------------------------------------------------------------
  -- Buses
  --------------------------------------------------------------------------
  --  ISOLATED SENSOR DOMAINS (FMUv6X redundancy): each IMU on its OWN SPI bus so
  --  a wedged bus / dead LDO kills ONE domain, not all three. Fault CONTAINMENT,
  --  not spare parts. The SPOF structure only appears if the buses are modeled
  --  separately (the old single-SPI model hid it). Each is also the unit of the
  --  jess<->relay seam (DD-015): jess's host exposes per-bus RegBus transport;
  --  relay's wasm drivers + estimator decode + vote over the set.
  bus SPI1  end SPI1;          -- IMU domain 1 (ICM-20649 / BMI088)
  bus SPI2  end SPI2;          -- IMU domain 2 (ICM-42688-P)
  bus SPI3  end SPI3;          -- IMU domain 3 (ICM-42670-P) + baro pair
  bus I2C_BUS  end I2C_BUS;    -- mag + the per-brick power monitors (INA228)
  bus CANFD    end CANFD;      -- DroneCAN / UAVCAN peripherals + smart actuators

  --  POWER REDUNDANCY (triple source, hardware failover). Three input rails are
  --  diode/priority-ORed in HARDWARE onto the system rail -> failover is automatic
  --  with NO software in the path (the safety-critical property). Software only
  --  MONITORS each brick (INA228 over I2C) and per-IMU LDO; it never gates the
  --  switchover. Per-sensor LDO rails give each IMU domain independent power.
  bus VBRICK1  end VBRICK1;    -- POWER1 module input (PM02D/PM03D brick)
  bus VBRICK2  end VBRICK2;    -- POWER2 module input (second brick)
  bus VUSB     end VUSB;       -- USB 5V (third source / bench power)
  bus VSYS     end VSYS;       -- ORed system rail feeding the FMU + LDOs

  --  Inter-core / inter-MCU comms fabrics. These carry the WIT-typed RPC
  --  contracts (the salvageable wRPC idea: CM value encoding over a transport
  --  we build, NOT the host/cloud wRPC crates). Same-core comms is meld fusion
  --  (direct calls); cross-core comms is RPC over one of these buses.
  bus SHMEM    end SHMEM;      -- M7<->M4 shared-memory ring + MU mailbox IRQ (RPMsg/ICMsg-class)
  bus IO_LINK  end IO_LINK;    -- FMU<->IO MCU: LPUART6 @ 1.5 Mbaud (px4io-class register protocol)

  --  X500 V2 AIRFRAME I/O — the bought external peripherals (BOM: DD-022 / REQ-PIX-020).
  --  These are the FMU serial/PWM/RC lines and the main battery rail on the physical
  --  vehicle. gale provides the native TCB primitives (LPUART/FlexPWM); relay owns the
  --  driver bodies (u-blox UBX, TF02, SiK/MAVLink) behind the DD-018 embedded-io-async seam.
  bus GPS1_SER  end GPS1_SER;   -- LPUART: Holybro M9N #1 (u-blox M9N, UBX)
  bus GPS2_SER  end GPS2_SER;   -- LPUART: Holybro M9N #2 (dual-GNSS redundancy / blend)
  bus LIDAR_SER end LIDAR_SER;  -- LPUART: Benewake TF02 Pro 40 m rangefinder (REQ-PIX-020)
  bus TELEM_SER end TELEM_SER;  -- LPUART: Holybro 433 MHz SiK telemetry (off-board MAVLink)
  bus ESC_PWM   end ESC_PWM;    -- FlexPWM x4 -> X500 V2 ESCs (DShot/PWM), driven by the IO mixer
  bus RC_LINK   end RC_LINK;    -- RC/SBUS in -> IO_MCU failsafe (independent manual path)
  bus VBAT      end VBAT;       -- Gens Ace 4S 5000 mAh main rail (ESC power + monitored)

  --------------------------------------------------------------------------
  -- Data carried across cores. Ports bind the data IMPLEMENTATIONS (.nav / .pwm) so
  -- spar codegen emits STRUCTURED WIT records (not opaque list<u8>) - the typed inter-
  -- core contract of REQ-PIX-007. Field width comes from F32's Data_Size (4 B) +
  -- Data_Representation (Float) -> f32 (spar REQ-CODEGEN-WIT-RECORDS-001).
  --------------------------------------------------------------------------
  data F32
    properties
      Data_Model::Data_Representation => Float;
      Data_Size => 4 Bytes;
  end F32;

  data VehicleState end VehicleState;   -- estimator -> controller (the M4->M7 NavState)
  data implementation VehicleState.nav  -- 16 x f32 IEKF state (quat, pos, vel, gyro-bias, accel-bias) = 64 B
  subcomponents
    qw : data F32;  qx : data F32;  qy : data F32;  qz : data F32;
    px : data F32;  py : data F32;  pz : data F32;
    vx : data F32;  vy : data F32;  vz : data F32;
    bgx : data F32; bgy : data F32; bgz : data F32;
    bax : data F32; bay : data F32; baz : data F32;
  end VehicleState.nav;

  data ActuatorCmd end ActuatorCmd;     -- controller -> failsafe/mixer (per-motor setpoints)
  data implementation ActuatorCmd.pwm   -- 4 x f32 per-motor commands (the M7->F100 gust crossing)
  subcomponents
    m0 : data F32;  m1 : data F32;  m2 : data F32;  m3 : data F32;
  end ActuatorCmd.pwm;

  data ImuSample end ImuSample;         -- raw IMU seam (jess#167): FANS OUT to M4 ekf AND M7 rate loop
  data implementation ImuSample.raw     -- 6 x f32 = gyro(3) + accel(3). The M7 rate loop reads the raw
  subcomponents                         -- gyro here (freshest, no cross-core delay) and bias-corrects it
    gx : data F32;  gy : data F32;  gz : data F32;   -- with VehicleState.nav's gyro-bias; the M4 ekf
    ax : data F32;  ay : data F32;  az : data F32;   -- consumes gyro+accel. Rates are NOT in NavState.
  end ImuSample.raw;

  --------------------------------------------------------------------------
  -- Sensor + power devices
  --------------------------------------------------------------------------
  --  Each IMU is its OWN isolated domain: a dedicated SPI bus + a dedicated LDO
  --  rail (independent power control). Redundancy management (voting/selection)
  --  is NOT here — it is relay's estimator (portable, verified) over the set.
  --  IMU1 — ICM-20649 or BMI088 (populated as one). Domain 1.
  device IMU_20649_BMI088
  features
    spi : requires bus access SPI1;
    pwr : requires bus access VSYS;   -- via its own LDO (ldo1)
  end IMU_20649_BMI088;

  --  IMU2 — TDK ICM-42688-P (jess no_std driver falcon-imu-icm42688). Domain 2.
  device ICM42688P
  features
    spi : requires bus access SPI2;
    pwr : requires bus access VSYS;   -- via ldo2
  end ICM42688P;

  --  IMU3 — TDK ICM-42670-P. Domain 3.
  device ICM42670P
  features
    spi : requires bus access SPI3;
    pwr : requires bus access VSYS;   -- via ldo3
  end ICM42670P;

  --  Barometer — 2x Bosch BMP388 (double-redundant, separate buses).
  device BMP388
  features
    spi : requires bus access SPI3;
  end BMP388;

  --  Magnetometer — Bosch BMM150.
  device BMM150
  features
    i2c : requires bus access I2C_BUS;
  end BMM150;

  --------------------------------------------------------------------------
  -- Power redundancy: 3 sources -> hardware OR -> system rail; software monitors
  --------------------------------------------------------------------------
  --  POWER1/POWER2 digital power modules (TI INA228). The brick supplies VBRICKn
  --  (power) and is monitored over I2C (voltage/current/health -> software).
  device PM02D
  features
    i2c   : requires bus access I2C_BUS;   -- monitor channel (read-only to SW)
    vout  : provides bus access VBRICK1;    -- brick 1 power output
  end PM02D;
  device PM02D_2
  features
    i2c   : requires bus access I2C_BUS;
    vout  : provides bus access VBRICK2;    -- brick 2 power output
  end PM02D_2;

  --  USB 5V — third source.
  device USB_PWR
  features
    vout : provides bus access VUSB;
  end USB_PWR;

  --  The power-path OR/selection: diode/priority-OR of the 3 inputs onto VSYS.
  --  Pure HARDWARE — no software in the failover path. This is the keystone of
  --  power redundancy: loss of any one (or two) sources does NOT drop VSYS.
  device PWR_OR
  features
    in1 : requires bus access VBRICK1;
    in2 : requires bus access VBRICK2;
    in3 : requires bus access VUSB;
    out : provides bus access VSYS;
  end PWR_OR;

  --  Per-IMU LDO regulators off VSYS — independent power control per sensor
  --  domain (a dead LDO takes out one IMU, not the rail).
  device LDO
  features
    vin  : requires bus access VSYS;
  end LDO;

  --------------------------------------------------------------------------
  -- X500 V2 EXTERNAL PERIPHERALS (the bought vehicle: DD-022 / REQ-PIX-020)
  --------------------------------------------------------------------------
  --  Dual Holybro M9N: u-blox M9N GNSS over LPUART (UBX) + an IST8310 compass over
  --  I2C on the same combo module -> dual GNSS + dual external mag, blended under the
  --  DD-014 health vote. Two independent instances so one dead module is a degrade, not a loss.
  device GPS_M9N_1
  features
    ser     : requires bus access GPS1_SER;
    mag_i2c : requires bus access I2C_BUS;
    pwr     : requires bus access VSYS;
  end GPS_M9N_1;
  device GPS_M9N_2
  features
    ser     : requires bus access GPS2_SER;
    mag_i2c : requires bus access I2C_BUS;
    pwr     : requires bus access VSYS;
  end GPS_M9N_2;

  --  Benewake TF02 Pro LiDAR 40 m rangefinder (REQ-PIX-020): distance/quality over LPUART.
  --  MONITOR/augment for AGL altitude + landing; degrades to baro-only (DD-014), never a dependency.
  device LIDAR_TF02
  features
    ser : requires bus access LIDAR_SER;
    pwr : requires bus access VSYS;
  end LIDAR_TF02;

  --  Holybro 433 MHz SiK telemetry radio: transparent LPUART carrying MAVLink to the GCS.
  device TELEM_SIK
  features
    ser : requires bus access TELEM_SER;
    pwr : requires bus access VSYS;
  end TELEM_SIK;

  --  X500 V2 ESC + motor (x4, quad-X). PWM/DShot in from the IO_MCU mixer; power off the 4S rail.
  device ESC_MOTOR
  features
    pwm : requires bus access ESC_PWM;
    pwr : requires bus access VBAT;
  end ESC_MOTOR;

  --  RC receiver -> IO_MCU (SBUS): the independent manual / RC-loss failsafe path.
  device RC_RX
  features
    rc : provides bus access RC_LINK;
  end RC_RX;

  --  Gens Ace 4S 5000 mAh main battery -> VBAT (ESC power; monitored by the power module).
  device BATTERY_4S
  features
    vout : provides bus access VBAT;
  end BATTERY_4S;

  --------------------------------------------------------------------------
  -- Software: the verified falcon flight stack + the I/O failsafe path
  --------------------------------------------------------------------------
  --  falcon: geometric attitude -> ADRC -> mixer cascade. A fused component
  --  (meld) compiled wasm -> synth to the M7. (jess //:falcon-firmware)
  --  Consumes state from the M4 estimator over SHMEM; emits actuator commands
  --  to the I/O MCU over IO_LINK. Same WIT contract whether fused or RPC'd.
  process Falcon_Flight
  features
    state_in : in data port VehicleState.nav;     -- <- estimator (cross-core RPC)
    imu_in   : in data port ImuSample.raw;        -- <- raw IMU (M7-co-scheduled): the rate loop's
                                                  --    fresh gyro, bias-corrected by state_in (jess#167)
    cmd_out  : out data port ActuatorCmd.pwm;     -- -> failsafe (cross-MCU RPC)
  end Falcon_Flight;
  process implementation Falcon_Flight.cascade
  end Falcon_Flight.cascade;

  --  "another fused system": the IEKF state estimator, offloaded to the idle
  --  M4 core as its own fused component. Emits VehicleState to the M7.
  process Estimator
  features
    imu_in    : in data port ImuSample.raw;        -- <- raw IMU: gyro+accel feed the IEKF
    state_out : out data port VehicleState.nav;
  end Estimator;
  process implementation Estimator.iekf
  end Estimator.iekf;

  --  I/O failsafe + PWM mixing on the STM32F100. Receives actuator commands
  --  from the FMU over the LPUART link.
  process IO_Failsafe
  features
    cmd_in : in data port ActuatorCmd.pwm;
  end IO_Failsafe;
  process implementation IO_Failsafe.pwm
  end IO_Failsafe.pwm;

  --------------------------------------------------------------------------
  -- The board, assembled
  --------------------------------------------------------------------------
  system Pixhawk6XRT
  end Pixhawk6XRT;

  system implementation Pixhawk6XRT.v2a
  subcomponents
    m7   : processor FMU_M7.imxrt1176;
    m4   : processor FMU_M4.imxrt1176;
    io   : processor IO_MCU.stm32f100;

    itcm  : memory ITCM;
    dtcm  : memory DTCM;
    ocram : memory OCRAM;
    flash : memory OSPI_FLASH;

    spi1 : bus SPI1;   -- isolated IMU domains
    spi2 : bus SPI2;
    spi3 : bus SPI3;
    i2c  : bus I2C_BUS;
    can  : bus CANFD;
    shmem : bus SHMEM;
    io_link : bus IO_LINK;

    gps1_ser : bus GPS1_SER;   -- X500 V2 airframe I/O buses (DD-022)
    gps2_ser : bus GPS2_SER;
    lidar_ser : bus LIDAR_SER;
    telem_ser : bus TELEM_SER;
    esc_pwm : bus ESC_PWM;
    rc_link : bus RC_LINK;
    vbat : bus VBAT;

    vbrick1 : bus VBRICK1;   -- power redundancy rails
    vbrick2 : bus VBRICK2;
    vusb    : bus VUSB;
    vsys    : bus VSYS;

    imu1 : device IMU_20649_BMI088;
    imu2 : device ICM42688P;
    imu3 : device ICM42670P;
    baro_a : device BMP388;
    baro_b : device BMP388;
    mag  : device BMM150;

    brick1 : device PM02D;     -- POWER1 module (+monitor)
    brick2 : device PM02D_2;   -- POWER2 module (+monitor)
    usbpwr : device USB_PWR;   -- USB 5V
    pwr_or : device PWR_OR;    -- hardware OR -> vsys
    ldo1 : device LDO;         -- per-IMU-domain regulators off vsys
    ldo2 : device LDO;
    ldo3 : device LDO;

    gps1 : device GPS_M9N_1;    -- X500 V2 externals: dual GNSS + ext mag (DD-022)
    gps2 : device GPS_M9N_2;
    lidar : device LIDAR_TF02;  -- TF02 Pro rangefinder (REQ-PIX-020)
    telem : device TELEM_SIK;   -- 433 MHz SiK
    esc1 : device ESC_MOTOR;    -- quad-X motors
    esc2 : device ESC_MOTOR;
    esc3 : device ESC_MOTOR;
    esc4 : device ESC_MOTOR;
    rcrx : device RC_RX;
    battery : device BATTERY_4S;

    falcon : process Falcon_Flight.cascade;
    estimator : process Estimator.iekf;
    failsafe : process IO_Failsafe.pwm;

  connections
    --  Isolated sensor domains: one IMU per SPI bus (fault containment).
    imu1_spi : bus access spi1 <-> imu1.spi;
    imu2_spi : bus access spi2 <-> imu2.spi;
    imu3_spi : bus access spi3 <-> imu3.spi;
    baroa_spi : bus access spi3 <-> baro_a.spi;
    barob_spi : bus access spi3 <-> baro_b.spi;
    mag_i2c : bus access i2c <-> mag.i2c;
    brick1_i2c : bus access i2c <-> brick1.i2c;
    brick2_i2c : bus access i2c <-> brick2.i2c;

    --  Power redundancy: 3 sources -> hardware OR -> vsys -> per-IMU LDOs.
    b1_out : bus access brick1.vout <-> vbrick1;
    b2_out : bus access brick2.vout <-> vbrick2;
    usb_out : bus access usbpwr.vout <-> vusb;
    or_in1 : bus access vbrick1 <-> pwr_or.in1;
    or_in2 : bus access vbrick2 <-> pwr_or.in2;
    or_in3 : bus access vusb <-> pwr_or.in3;
    or_out : bus access pwr_or.out <-> vsys;
    ldo1_in : bus access vsys <-> ldo1.vin;
    ldo2_in : bus access vsys <-> ldo2.vin;
    ldo3_in : bus access vsys <-> ldo3.vin;
    imu1_pwr : bus access vsys <-> imu1.pwr;
    imu2_pwr : bus access vsys <-> imu2.pwr;
    imu3_pwr : bus access vsys <-> imu3.pwr;

    --  X500 V2 externals (DD-022): dual GPS (UBX serial + I2C ext mag), LiDAR, telemetry,
    --  quad-X ESCs off the 4S rail, RC input to the IO failsafe, battery -> VBAT.
    gps1_s : bus access gps1_ser <-> gps1.ser;
    gps2_s : bus access gps2_ser <-> gps2.ser;
    gps1_m : bus access i2c <-> gps1.mag_i2c;
    gps2_m : bus access i2c <-> gps2.mag_i2c;
    lidar_s : bus access lidar_ser <-> lidar.ser;
    telem_s : bus access telem_ser <-> telem.ser;
    esc1_p : bus access esc_pwm <-> esc1.pwm;
    esc2_p : bus access esc_pwm <-> esc2.pwm;
    esc3_p : bus access esc_pwm <-> esc3.pwm;
    esc4_p : bus access esc_pwm <-> esc4.pwm;
    rc_in  : bus access rcrx.rc <-> rc_link;
    bat_out : bus access battery.vout <-> vbat;
    esc1_v : bus access vbat <-> esc1.pwr;
    esc2_v : bus access vbat <-> esc2.pwr;
    esc3_v : bus access vbat <-> esc3.pwr;
    esc4_v : bus access vbat <-> esc4.pwr;
    gps1_v : bus access vsys <-> gps1.pwr;
    gps2_v : bus access vsys <-> gps2.pwr;
    lidar_v : bus access vsys <-> lidar.pwr;
    telem_v : bus access vsys <-> telem.pwr;

    --  Cross-core / cross-MCU WIT-typed contracts (the wRPC topology).
    est_to_falcon : port estimator.state_out -> falcon.state_in;   -- M4 -> M7
    falcon_to_io  : port falcon.cmd_out -> failsafe.cmd_in;         -- M7 -> IO

  properties
    --  Software-to-core bindings: estimator on M4, falcon on M7, failsafe on IO.
    Actual_Processor_Binding => (reference (m7)) applies to falcon;
    Actual_Processor_Binding => (reference (m4)) applies to estimator;
    Actual_Processor_Binding => (reference (io)) applies to failsafe;

    --  Connection bindings: the cross-processor contracts ride a transport bus.
    --  (spar's wrpc-binding analysis checks exactly this — a cross-core
    --  connection must be bound to a bus, i.e. an explicit RPC transport.)
    Actual_Connection_Binding => (reference (shmem)) applies to est_to_falcon;
    Actual_Connection_Binding => (reference (io_link)) applies to falcon_to_io;
  end Pixhawk6XRT.v2a;

end Pixhawk6XRT;
