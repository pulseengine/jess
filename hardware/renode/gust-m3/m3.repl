// Minimal Cortex-M3 (STM32F100-class = the F100 gust failsafe core): flash @0x0,
// 256 KB SRAM @0x20000000 (covers synth's linear memory + initial SP 0x20020000).
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m3"
    nvic: nvic
nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0
flash: Memory.MappedMemory @ sysbus 0x0
    size: 0x40000
sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x40000
