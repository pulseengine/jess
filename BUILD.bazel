# jess hermetic build — falcon firmware chain, tracked via rules_wasm_component.
# Run (deferred while gale uses the rig):  bazel build //:falcon-validate //:falcon-optimized
load("@rules_wasm_component//wasm:defs.bzl", "meld_fuse", "synth_compile", "wasm_optimize", "wasm_validate")
load("//bazel:adopt.bzl", "adopt_wasm_component")

# falcon's verified flight component (fetched + sha256-pinned in MODULE.bazel),
# adopted into a WasmComponentInfo so rules_wasm_component rules can consume it
# (rules_wasm_component lacks a prebuilt-component adopt rule — see rwc#489).
adopt_wasm_component(
    name = "falcon-flight",
    wasm = "@falcon_flight_wasm//file",
    visibility = ["//visibility:public"],
)

# Pipeline order is meld → loom → synth: FUSE first, then let LOOM optimize the
# fused whole (more cross-component optimization than per-component), then synth
# to ARM. (Phase-2/maximal-wasm: gale + kiln compiled to wasm get fused in here
# too, so loom optimizes the entire fused system — see DD-006/DD-009.)

wasm_validate(
    name = "falcon-validate",
    component = ":falcon-flight",
)

# 1. meld — fuse the component(s) into one core module.
# rwc v1.1.0 (#468) ships meld_fuse + synth_compile as hermetic toolchains, so
# the chain needs no verus/rocq/lean proof toolchains.
meld_fuse(
    name = "falcon-fused",
    components = [":falcon-flight"],
    memory_strategy = "shared",
    validate = True,
)

# 2. loom — optimize the FUSED module. The behavioral SIL gate (runbook §3a)
# caught loom's `dead-stores` pass MISCOMPILING the fused falcon core
# (eliminates a live float store: run-stabilization 0.0234 → 0.329, valid but
# wrong) — pass-bisected, filed loom#220 / AFD-023. Interim: run every pass
# EXCEPT dead-stores (SIL-verified correct, still optimizes). Drop this `passes`
# override once loom#220 lands.
wasm_optimize(
    name = "falcon-optimized",
    component = ":falcon-fused",
    passes = [
        "directize",
        "inline",
        "precompute",
        "constant-folding",
        "canonicalize",
        "peephole-synth",
        "cse",
        "advanced",
        "branches",
        "dce",
        "merge-blocks",
        "vacuum",
        "simplify-locals",
        "dead-locals",
        "vacuum-final",
    ],
)

# 3. synth — compile the optimized fused module to an ARM Cortex-M ELF.
synth_compile(
    name = "falcon-firmware",
    wasm_module = ":falcon-optimized",
    target = "cortex-m4f",               # gale's STM32F4 target
    all_exports = True,                  # NOTE: exports-only until synth#275 dispatch lands
)

