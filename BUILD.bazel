# jess hermetic build — falcon firmware chain, tracked via rules_wasm_component.
# Run (deferred while gale uses the rig):  bazel build //:falcon-validate //:falcon-optimized
load("@rules_wasm_component//wasm:defs.bzl", "meld_fuse", "synth_compile", "wasm_optimize", "wasm_validate")
load("//bazel:adopt.bzl", "adopt_wasm_component")

# falcon's verified flight component (fetched + sha256-pinned in MODULE.bazel),
# adopted into a WasmComponentInfo so rules_wasm_component rules can consume it
# (rules_wasm_component lacks a prebuilt-component adopt rule — see rwc#489).
adopt_wasm_component(
    name = "falcon-flight",
    wasm = "@falcon_flight_wasm//file",
    visibility = ["//visibility:public"],
)

# --- HERMETIC TODAY: validate + optimize via rules_wasm_component toolchains ---
wasm_validate(
    name = "falcon-validate",
    component = ":falcon-flight",
)

# wasm_optimize runs LOOM over the fetched falcon component. Enabled now that
# rwc#490 is fixed (PR #497, on the pinned main SHA): the loom_wrapper resolves
# the symlinked input and locates wasmtime as an action input. Verified
# end-to-end — 4/4 core modules optimized and the SIL gate is exact raw-vs-opt
# (jess runbook §3a). NOTE: the stable-2026-03 bundle's loom is v0.3.0 (predates
# loom#172/#196); behaviorally faithful on falcon today, gated by the SIL diff.
wasm_optimize(
    name = "falcon-optimized",
    component = ":falcon-flight",
)

# --- HERMETIC (AFD-005 unblocked): fuse -> compile ---------------------------
# rwc v1.1.0 (#468) ships meld_fuse + synth_compile as hermetic toolchains, so
# the firmware chain is now expressible without dragging the verus/rocq/lean
# proof toolchains in. Verifying this stage builds against the v1.1.0 pin.
meld_fuse(
    name = "falcon-fused",
    components = [":falcon-flight"],
    memory_strategy = "shared",
    validate = True,
)

synth_compile(
    name = "falcon-firmware",
    wasm_module = ":falcon-fused",
    target = "cortex-m4f",               # gale's STM32F4 target
    all_exports = True,                  # NOTE: exports-only until synth#275 dispatch lands
)

